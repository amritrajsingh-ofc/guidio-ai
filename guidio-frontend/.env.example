# Copy this file to ".env.local" and fill in your own values.
# NEVER commit ".env.local". Only this example file belongs in Git.

# Backend URL, no trailing slash.
# Local:      http://localhost:5000
# Production: https://your-service.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Clerk publishable key (starts with pk_test_ in Development Mode).
# This key is safe to expose in the browser.
VITE_CLERK_PUBLISHABLE_KEY=

# Clerk routes. These match the routes in src/App.jsx.
VITE_CLERK_SIGN_IN_URL=/sign-in
VITE_CLERK_SIGN_UP_URL=/sign-up
VITE_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
VITE_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard